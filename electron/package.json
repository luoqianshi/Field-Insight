{
  "name": "tianjianzhikan-desktop",
  "version": "0.5.9",
  "private": true,
  "description": "田间智瞰 Electron 桌面壳（含设置模块）",
  "author": "luoqianshi",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "build:dir": "electron-builder --win --x64 --dir",
    "build:installer": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.luoqianshi.tianjianzhikan",
    "productName": "TianJianZhiKan",
    "directories": {
      "output": "dist"
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "publish": null,
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend-dist/TianJianZhiKanBackend",
        "to": "backend"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/app.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "menuCategory": false,
      "shortcutName": "田间智瞰",
      "uninstallDisplayName": "田间智瞰",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "artifactName": "TianJianZhiKan-v${version}-win-x64-setup.${ext}",
      "installerIcon": "build/app.ico",
      "uninstallerIcon": "build/app.ico",
      "installerHeaderIcon": "build/app.ico"
    }
  }
}
